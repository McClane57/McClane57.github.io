{
  // Cloudflare Worker config. Deployed by Workers Builds (Git integration):
  // a push to master deploys production; other branches upload a preview version
  // with its own *.workers.dev preview URL.
  "name": "grishchenko-org",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // The Worker runs only for the retired URLs, which answer 410 (src/worker.js).
    // Everything else is served by the assets layer without a Worker invocation,
    // with headers from _headers.
    "run_worker_first": ["/coaching", "/coaching/*", "/files/Grishchenko_CV.pdf", "/files/New_CV-8.pdf"],
    // Unknown paths get /404.html with status 404.
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": true
}
