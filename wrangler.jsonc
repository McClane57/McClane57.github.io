{
  // Cloudflare Worker config. Deployed by Workers Builds (Git integration):
  // a push to master deploys production; other branches upload a preview version
  // with its own *.workers.dev preview URL.
  "name": "grishchenko-org",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // The Worker runs first so that every response gets the security headers
    // and the retired URLs answer 410 (src/worker.js).
    "run_worker_first": true,
    // Unknown paths get /404.html with status 404.
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": true
}
